[Unit]
Description=HT1 API #1 - Python Flask
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/HT1_SEMI1_2S2026/api-1-python
Environment=CARNET=202307546
Environment=PORT=8080
ExecStart=/home/ubuntu/HT1_SEMI1_2S2026/api-1-python/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
